[TITLE]
swmm5-cplus coupling demo: downstream trunk (receives the upstream flow at node IN, 5 ft below the upstream outfall)

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           06/01/2026
START_TIME           00:00:00
REPORT_START_DATE    06/01/2026
REPORT_START_TIME    00:00:00
END_DATE             06/01/2026
END_TIME             12:00:00
DRY_STEP             01:00:00
WET_STEP             00:01:00
ROUTING_STEP         0:00:05
REPORT_STEP          00:05:00
VARIABLE_STEP        0.00
ALLOW_PONDING        NO
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH

[RAINGAGES]
;;Name  Format    Interval SCF  Source
RG1     INTENSITY 0:15     1.0  TIMESERIES STORM

[SUBCATCHMENTS]
;;Name  Raingage Outlet  Area  %Imperv Width %Slope CurbLen
S3      RG1      J3      30    70      1500  1.0    0

[SUBAREAS]
;;Subcatch N-Imperv N-Perv S-Imperv S-Perv PctZero RouteTo
S3        0.013    0.15   0.05     0.20   25      OUTLET

[INFILTRATION]
;;Subcatch MaxRate MinRate Decay DryTime MaxInfil
S3        3.0     0.5     4     7       0

[JUNCTIONS]
;;Name Elev  MaxDepth InitDepth SurDepth Aponded
IN     95.0  10       0         0        0
J3     92.0  10       0         0        0

[OUTFALLS]
;;Name Elev  Type
OB     88.0  FREE

[CONDUITS]
;;Name From To  Length Roughness InOffset OutOffset
C3     IN   J3  800    0.013     0        0
C4     J3   OB  500    0.013     0        0

[XSECTIONS]
;;Link Shape    Geom1 Geom2 Geom3 Geom4 Barrels
C3     CIRCULAR 3.0   0     0     0     1
C4     CIRCULAR 3.5   0     0     0     1

[TIMESERIES]
;;Name  Time  Value (in/hr)
STORM   0:00  0.0
STORM   0:15  0.4
STORM   0:30  1.1
STORM   0:45  2.6
STORM   1:00  1.4
STORM   1:15  0.7
STORM   1:30  0.3
STORM   1:45  0.1
STORM   2:00  0.0

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

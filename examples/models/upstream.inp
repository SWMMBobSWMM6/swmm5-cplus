[TITLE]
swmm5-cplus coupling demo: upstream catchment (drains to outfall OA)

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           06/01/2026
START_TIME           00:00:00
REPORT_START_DATE    06/01/2026
REPORT_START_TIME    00:00:00
END_DATE             06/01/2026
END_TIME             12:00:00
DRY_STEP             01:00:00
WET_STEP             00:01:00
ROUTING_STEP         0:00:05
REPORT_STEP          00:05:00
VARIABLE_STEP        0.00
ALLOW_PONDING        NO
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH

[RAINGAGES]
;;Name  Format    Interval SCF  Source
RG1     INTENSITY 0:15     1.0  TIMESERIES STORM

[SUBCATCHMENTS]
;;Name  Raingage Outlet  Area  %Imperv Width %Slope CurbLen
S1      RG1      J1      40    45      1800  1.0    0
S2      RG1      J2      25    60      1200  1.5    0

[SUBAREAS]
;;Subcatch N-Imperv N-Perv S-Imperv S-Perv PctZero RouteTo
S1        0.013    0.15   0.05     0.20   25      OUTLET
S2        0.013    0.15   0.05     0.20   25      OUTLET

[INFILTRATION]
;;Subcatch MaxRate MinRate Decay DryTime MaxInfil
S1        3.0     0.5     4     7       0
S2        3.0     0.5     4     7       0

[JUNCTIONS]
;;Name Elev  MaxDepth InitDepth SurDepth Aponded
J1     110.0 8        0         0        0
J2     104.0 8        0         0        0

[OUTFALLS]
;;Name Elev  Type
OA     100.0 FREE

[CONDUITS]
;;Name From To  Length Roughness InOffset OutOffset
C1     J1   J2  600    0.013     0        0
C2     J2   OA  400    0.013     0        0

[XSECTIONS]
;;Link Shape    Geom1 Geom2 Geom3 Geom4 Barrels
C1     CIRCULAR 2.0   0     0     0     1
C2     CIRCULAR 2.5   0     0     0     1

[TIMESERIES]
;;Name  Time  Value (in/hr)
STORM   0:00  0.0
STORM   0:15  0.4
STORM   0:30  1.1
STORM   0:45  2.6
STORM   1:00  1.4
STORM   1:15  0.7
STORM   1:30  0.3
STORM   1:45  0.1
STORM   2:00  0.0

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL
